# Server & Inbound Webhook Configuration
WEBHOOK_SECRET=nexus_mail_secret_change_in_production

# Outbound Email Delivery (Optional: Leave empty for local simulation mode)
# You can use Brevo (free 300 emails/day), Resend, Amazon SES, or any SMTP provider:
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_login
SMTP_PASS=your_smtp_key

# Supabase / PostgreSQL (Optional: Defaults to local file-based storage)
DATABASE_URL=
